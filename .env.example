# Public URL
APP_URL=http://localhost:3000

# Linear OAuth application
LINEAR_CLIENT_ID=
LINEAR_REDIRECT_URI=http://localhost:3000/api/auth/linear/callback

# 32-byte key encoded as base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Neon pooled connection string
DATABASE_URL=

# Optional: Pusher Channels for instant updates (polling works without it)
# Leave all six values blank for polling-only setup. To enable Pusher, fill all six.
# Public key/cluster must match the server values; never expose PUSHER_SECRET.
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Optional: enable per-user Slack OAuth channel selection. Server-only secrets.
# Callback is APP_URL + /api/auth/slack/callback (HTTPS). See docs/slack-setup.md.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional: personal Sentry project. DSN is public; auth token is build-only.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
