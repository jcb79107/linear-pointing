# Public URL
APP_URL=http://localhost:3000

# Linear OAuth application
LINEAR_CLIENT_ID=
LINEAR_REDIRECT_URI=http://localhost:3000/api/auth/linear/callback

# 32-byte key encoded as base64. Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Neon pooled connection string
DATABASE_URL=

# Pusher Channels
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=
NEXT_PUBLIC_PUSHER_KEY=
NEXT_PUBLIC_PUSHER_CLUSTER=

# Optional: incoming webhook for the Slack channel that receives invites
SLACK_INVITE_WEBHOOK_URL=
# Optional: label shown in the confirmation dialog (for example, #engineering)
SLACK_INVITE_CHANNEL=
